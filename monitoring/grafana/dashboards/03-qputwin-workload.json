{
  "uid": "qputwin-workload",
  "title": "QPUTwin Workload",
  "description": "What the twins are being asked to run.",
  "tags": [
    "qputwin"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "backend",
        "label": "Twin",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(qputwin_tel_span_ms_count, backend)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Mix",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Engine",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (engine) (rate(qputwin_tel_jobs_total{backend=~\"$backend\",status=\"COMPLETED\"}[1m]))",
          "legendFormat": "{{engine}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: jobs/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
