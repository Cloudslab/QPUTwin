{
  "uid": "qputwin-containers",
  "title": "Containers",
  "description": "cAdvisor metrics per container.",
  "tags": [
    "qputwin"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Stack",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{service!=\"\"}, project)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{service!=\"\"}, service)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Containers right now",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{service=~\"$service\",project=~\"$project\"}[1m]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (container_memory_working_set_bytes{service=~\"$service\",project=~\"$project\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "B",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (container_spec_memory_limit_bytes{service=~\"$service\",project=~\"$project\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "C",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (service:cpu_throttled:ratio1m{service=~\"$service\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "D",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "Service",
              "Value #A": "CPU cores",
              "Value #B": "Memory",
              "Value #C": "Memory limit",
              "Value #D": "Throttled"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU cores"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "none"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Throttled"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU, by service",
      "description": "One unit is one full core.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{service=~\"$service\",project=~\"$project\"}[1m]))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
