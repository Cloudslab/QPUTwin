# ./up.sh copies this to .env (not tracked) and fills in the generated values.
GRAFANA_ADMIN_PASSWORD=generated-by-up.sh
QPUTWIN_UID=1000
QPUTWIN_GID=1000

# Address the web interfaces are published on. Keep 127.0.0.1 unless you have
# protected them: cAdvisor and Portainer can reach the Docker socket.
MONITORING_BIND=127.0.0.1

# How long Prometheus keeps metrics.
PROMETHEUS_RETENTION=15d

# Network created by the QPUTwin stack.
QPUTWIN_NETWORK=qputwin_qputwin-net

# Telemetry exporter: `end` counts new jobs only; `begin` replays data/telemetry.jsonl.
QPUTWIN_TEL_START=end
