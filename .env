# QPUTwin runtime configuration (read automatically by `docker compose`).
# Koustav Kumar Mondal <koustav@koustavmondal.com>
#
# Per-container simulation caps. Defaults equal each vendor's real physical
# qubit count; lower any of them to restrict an individual emulator. The memory
# guard additionally rejects any job whose dense statevector would not fit in
# the container's memory limit (returns ResourceLimitError instead of OOM).
QPUTWIN_HELIOS_MAX_QUBITS=98
QPUTWIN_FORTE_MAX_QUBITS=36
QPUTWIN_ANKAA3_MAX_QUBITS=84
QPUTWIN_EMERALD_MAX_QUBITS=54

# Statevector precision for all workers: complex128 (default) | complex64 (half memory)
QPUTWIN_PRECISION=complex128

# Per-worker resource limits (identical for every QPU so latency comparisons are fair)
QPUTWIN_WORKER_CPUS=4
QPUTWIN_WORKER_MEM=12g

# Simulation-engine threads per job. Empty = the worker's CPU quota above; 1 = single-threaded.
QPUTWIN_ENGINE_THREADS=

# Orchestrator host port(s) and the uid/gid used to write ./data (telemetry + job store).
# With QPUTWIN_ORCHESTRATOR_REPLICAS > 1 give a range (e.g. 8000-8002) and use the
# `ha` profile gateway on QPUTWIN_GATEWAY_PORT.
QPUTWIN_ORCHESTRATOR_PORTS=8000
QPUTWIN_ORCHESTRATOR_REPLICAS=1
QPUTWIN_GATEWAY_PORT=8080
QPUTWIN_UID=1000
QPUTWIN_GID=1000

# Horizontal scaling: worker replicas per QPU (the orchestrator discovers them via DNS)
QPUTWIN_HELIOS_REPLICAS=1
QPUTWIN_FORTE_REPLICAS=1
QPUTWIN_ANKAA3_REPLICAS=1
QPUTWIN_EMERALD_REPLICAS=1

# Calibrated data (paths inside the container; ./config/devices is mounted at
# /app/config/devices). Empty = the packaged nominal map / calibration.
# e.g. QPUTWIN_ANKAA3_COUPLING_MAP=/app/config/devices/example_rigetti_ankaa_3_defects.json
QPUTWIN_HELIOS_COUPLING_MAP=
QPUTWIN_FORTE_COUPLING_MAP=
QPUTWIN_ANKAA3_COUPLING_MAP=
QPUTWIN_EMERALD_COUPLING_MAP=
QPUTWIN_HELIOS_CALIBRATION=
QPUTWIN_FORTE_CALIBRATION=
QPUTWIN_ANKAA3_CALIBRATION=
QPUTWIN_EMERALD_CALIBRATION=

# API keys ("name:key[:max_priority]", comma-separated, keys >= 16 chars). Empty = open API.
QPUTWIN_API_KEYS=

# Research mode: reject noisy runs that would use calibration values not tagged "published".
QPUTWIN_REQUIRE_PUBLISHED_CALIBRATION=0
QPUTWIN_MAX_TRAJECTORIES=2000
