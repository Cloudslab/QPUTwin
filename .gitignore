# --- Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- packaging / build output
build/
dist/
